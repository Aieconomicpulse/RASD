# ---- Access -----------------------------------------------------------------
# Shared password for the portal gate (minister-facing). Rotate before each briefing round.
PORTAL_PASSWORD=change-me
# Long random string used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Sources (JSON endpoints). Leave empty to use data/snapshot.json or the sample. ----
# Live today — the KSA platform's news-sentiment API (open, no auth).
SOURCE_SENTIMENT_URL=https://ksa-cpi-intelligence-v2-fh4f.vercel.app/api/news-sentiment
# To wire: expose these from the KSA platform (see README › Wiring) and set the URLs.
SOURCE_CPI_URL=
SOURCE_MACRO_URL=
SOURCE_SUPPLY_URL=
SOURCE_MARKETS_URL=
# Optional: a hosted snapshot.json produced by scripts/build-snapshot.mjs (Blob, S3, GitHub raw…)
SNAPSHOT_URL=

# ---- Daily brief (optional) -------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Secret the Vercel cron must send as ?key=… to /api/cron/daily
CRON_SECRET=change-me
