# ---- Access -----------------------------------------------------------------
# Shared password for the portal gate (minister-facing). Rotate before each briefing round.
PORTAL_PASSWORD=change-me
# Long random string used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Sources ------------------------------------------------------------------
# Live at request time — the KSA platform's news-sentiment API.
SOURCE_SENTIMENT_URL=https://ksa-cpi-intelligence-v2-fh4f.vercel.app/api/news-sentiment
# Everything else comes from data/ksa/*.json, refreshed daily by `npm run refresh` (scripts/refresh-ksa-data.mjs):
KSA_BASE_URL=https://ksa-cpi-intelligence-v2-fh4f.vercel.app
# If Vercel Deployment Protection is on for that project, its "Protection Bypass for Automation" secret:
KSA_BYPASS_TOKEN=
# Optional: a hosted copy of data/desk.json (Hormuz state, hand-written alerts) the desk can edit without a deploy.
DESK_URL=

# ---- Daily brief (optional) -------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Secret the Vercel cron must send as ?key=… to /api/cron/daily
CRON_SECRET=change-me
